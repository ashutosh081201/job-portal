# Copy to .env and fill in. Never commit .env.
PORT=3000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jobverse
JWT_SECRET=<long-random-string>

# Comma-separated origins allowed to call the API (unset = any origin).
# "*" matches one hostname label, e.g. https://job-portal-*-<team>.vercel.app
# for Vercel's per-deployment URLs.
CLIENT_URL=http://localhost:5173

# Deadlines close at the end of the day in this time zone
APP_TIMEZONE=Asia/Kolkata

# Email: set BREVO_API_KEY to send over HTTPS (needed on Render's free tier);
# otherwise Gmail SMTP with an app password is used.
BREVO_API_KEY=
EMAIL_FROM=<verified-sender@example.com>
EMAIL_USER=<you@gmail.com>
EMAIL_PASS=<gmail-app-password>

# Resume PDF uploads
CLOUDINARY_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# ATS checker
GEMINI_API_KEY=<gemini-api-key>
# GEMINI_MODEL=gemini-3.6-flash
